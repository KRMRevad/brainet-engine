{
    "name": "Analytics Tracker",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "0 * * * *"
                        }
                    ]
                }
            },
            "id": "cron-trigger",
            "name": "Cron (Hourly)",
            "type": "n8n-nodes-base.cron",
            "typeVersion": 1,
            "position": [
                250,
                300
            ]
        },
        {
            "parameters": {
                "command": "echo 'Fetching YouTube/TikTok analytics...'"
            },
            "id": "fetch-analytics",
            "name": "Fetch Channel Stats (Mock)",
            "type": "n8n-nodes-base.executeCommand",
            "typeVersion": 1,
            "position": [
                450,
                300
            ]
        }
    ],
    "connections": {
        "Cron (Hourly)": {
            "main": [
                [
                    {
                        "node": "Fetch Channel Stats (Mock)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {}
}