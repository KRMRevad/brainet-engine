{
  "name": "brainet-mvp",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "server": "node server/server.js",
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "chrome": "open -n -a 'Google Chrome' --args --remote-debugging-port=9225 --user-data-dir=\"$HOME/.brainet-chrome\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "vis-network": "^9.1.9",
    "vis-data": "^7.1.9",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "puppeteer-core": "^24.0.0"
  }
}